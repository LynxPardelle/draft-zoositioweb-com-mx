          "display": "flex",
          "flexWrap": "wrap",
          "gap": "10px",
          "alignItems": "center"
        },
        "components": [
          "admin-blog-articulo-seoNavArticles",
          "admin-blog-articulo-seoNavNew",
          "admin-blog-articulo-seoNavMedia",
