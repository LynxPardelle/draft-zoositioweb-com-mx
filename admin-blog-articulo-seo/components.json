        "classes": "ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-bg-secondaryBgColor ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-textDecoration-none ank-display-flex ank-alignItems-center ank-justifyContent-center",
        "styles": {
          "minWidth": "max-content"
        }
      }
    },
    {
      "id": "admin-blog-articulo-seoNavAnalytics",
      "type": "link",
      "config": {
        "text": "Analíticas",
        "href": "/admin/blog/analiticas",
        "classes": "ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-bg-secondaryBgColor ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-textDecoration-none ank-display-flex ank-alignItems-center ank-justifyContent-center",
        "styles": {
          "minWidth": "max-content"
        }
      }
    },
    {
      "id": "admin-blog-articulo-seoNavCategories",
      "type": "link",
      "config": {
        "text": "Categorías",
        "href": "/admin/blog/categorias",
        "classes": "ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-bg-secondaryBgColor ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-textDecoration-none ank-display-flex ank-alignItems-center ank-justifyContent-center",
        "styles": {
          "minWidth": "max-content"
        }
      }
    },
    {
      "id": "admin-blog-articulo-seoNavTags",
      "type": "link",
      "config": {
        "text": "Tags",
        "href": "/admin/blog/tags",
        "classes": "ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-bg-secondaryBgColor ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-textDecoration-none ank-display-flex ank-alignItems-center ank-justifyContent-center",
        "styles": {
          "minWidth": "max-content"
        }
      }
    },
    {
      "id": "admin-blog-articulo-seoNavHub",
      "type": "link",
      "config": {
        "text": "Hub",
        "href": "/admin/blog/hub",
        "classes": "ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-bg-secondaryBgColor ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-textDecoration-none ank-display-flex ank-alignItems-center ank-justifyContent-center",
        "styles": {
          "minWidth": "max-content"
        }
      }
    },
    {
      "id": "admin-blog-articulo-seoNavConfig",
      "type": "link",
      "config": {
        "text": "Configuración",
        "href": "/admin/blog/configuracion",
        "classes": "ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-bg-secondaryBgColor ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-textDecoration-none ank-display-flex ank-alignItems-center ank-justifyContent-center",
        "styles": {
          "minWidth": "max-content"
        }
      }
    },
    {
      "id": "seoScope",
      "type": "interaction-scope",
      "config": {
        "scopeId": "articleSeo",
        "valueInstructions": "collectFields:articleId,revisionId,canonical,hreflang,socialPreview,structuredData,robots,sitemap,validationScope,validationNotes",
        "components": [
          "seoWorkspace"
        ]
      }
    },
    {
      "id": "seoWorkspace",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "ank-width-100per ank-bg-secondaryBgColor ank-border-1px__solid__textColorOPA__0_18 ank-borderRadius-8px ank-p-20px ank-display-flex ank-flexDirection-column ank-gap-14px",
        "components": [
          "seoArticleId",
          "seoGrid",
          "seoStructuredData",
          "seoValidationActions",
          "seoStatus"
        ]
      }
    },
    {
      "id": "seoArticleId",
      "type": "input",
      "config": {
        "fieldId": "articleId",
        "label": "Article ID",
        "controlType": "text",
        "helperText": "Se toma del query string articleId agregado al abrir desde la tabla.",
        "required": false,
        "readOnly": true,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px",
        "validation": []
      },
      "valueInstructions": "set:config.value,queryParamOr,articleId,"
    },
    {
      "id": "seoGrid",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-width-100per ank-display-grid ank-gap-14px",
        "styles": {
          "gridTemplateColumns": "repeat(auto-fit, minmax(min(100%, 240px), 1fr))"
        },
        "components": [
          "seoRevisionId",
          "seoCanonical",
          "seoHreflang",
          "seoSocialPreview",
          "seoRobots",
          "seoSitemap"
        ]
      }
    },
    {
      "id": "seoRevisionId",
      "type": "input",
      "config": {
        "fieldId": "revisionId",
        "label": "Revision ID",
        "controlType": "text",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px",
        "validation": []
      }
    },
    {
      "id": "seoCanonical",
      "type": "input",
      "config": {
        "fieldId": "canonical",
        "label": "Canonical",
        "controlType": "text",
        "placeholder": "https://zoositioweb.com.mx/blog/web/slug",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px",
        "validation": []
      }
    },
    {
      "id": "seoHreflang",
      "type": "input",
      "config": {
        "fieldId": "hreflang",
        "label": "hreflang",
        "controlType": "text",
        "placeholder": "es-MX, en-US",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px",
        "validation": []
      }
    },
    {
      "id": "seoSocialPreview",
      "type": "input",
      "config": {
        "fieldId": "socialPreview",
        "label": "Social preview",
        "controlType": "text",
        "placeholder": "Título y descripción para redes",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px",
        "validation": []
      }
    },
    {
      "id": "seoRobots",
      "type": "input",
      "config": {
        "fieldId": "robots",
        "label": "Robots",
        "controlType": "select",
        "value": "index,follow",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "options": [
          {
            "value": "index,follow",
            "label": "index,follow"
          },
          {
            "value": "noindex,follow",
            "label": "noindex,follow"
          }
        ],
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px ank-display-flex ank-alignItems-center ank-justifyContent-spaceBetween",
        "dropdownTriggerClasses": "ank-width-100per",
        "dropdownTriggerTextConfig": {
          "classes": "ank-width-100per ank-display-flex ank-alignItems-center"
        },
        "dropdownIndicatorText": "v",
        "dropdownIndicatorClasses": "ank-fontSize-18px ank-fontWeight-900",
        "optionContainerClasses": "ank-display-flex ank-flexDirection-column ank-gap-8px",
        "optionClasses": "ank-width-100per ank-p-12px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-titleColor ank-textAlign-left ank-cursor-pointer",
        "activeOptionClasses": "ank-bg-accentColor ank-color-onSuccessColor",
        "validation": []
      }
    },
    {
      "id": "seoSitemap",
      "type": "input",
      "config": {
        "fieldId": "sitemap",
        "label": "Sitemap",
        "controlType": "select",
        "value": "include",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "options": [
          {
            "value": "include",
            "label": "Incluir"
          },
          {
            "value": "exclude",
            "label": "Excluir"
          }
        ],
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px ank-display-flex ank-alignItems-center ank-justifyContent-spaceBetween",
        "dropdownTriggerClasses": "ank-width-100per",
        "dropdownTriggerTextConfig": {
          "classes": "ank-width-100per ank-display-flex ank-alignItems-center"
        },
        "dropdownIndicatorText": "v",
        "dropdownIndicatorClasses": "ank-fontSize-18px ank-fontWeight-900",
        "optionContainerClasses": "ank-display-flex ank-flexDirection-column ank-gap-8px",
        "optionClasses": "ank-width-100per ank-p-12px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-titleColor ank-textAlign-left ank-cursor-pointer",
        "activeOptionClasses": "ank-bg-accentColor ank-color-onSuccessColor",
        "validation": []
      }
    },
    {
      "id": "seoStructuredData",
      "type": "input",
      "config": {
        "fieldId": "structuredData",
        "label": "structuredData",
        "controlType": "textarea",
        "helperText": "JSON-LD seguro; el backend valida y sanitiza.",
        "rows": 8,
        "required": false,
        "readOnly": false,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px ank-py-12px",
        "validation": []
      }
    },
    {
      "id": "seoValidationActions",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-flexWrap-wrap ank-gap-12px",
        "components": [
          "seoValidateButton",
          "seoPublishButton"
        ]
      }
    },
    {
      "id": "seoValidateButton",
      "type": "button",
      "config": {
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-accentColor ank-color-onSuccessColor ank-fontWeight-900 ank-border-0 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-gap-8px ank-textDecoration-none",
        "disabledClasses": "zlp-cursor-not-allowed ank-opacity-0_45 ank-bg-secondaryTextColor ank-color-bgColor",
        "loadingClasses": "zlp-cursor-wait ank-opacity-0_85",
        "label": "Validar SEO",
        "loadingLabel": "Validando...",
        "disabledWhenInvalidScope": false,
        "iconPosition": "before"
      },
      "eventInstructions": "proxyAction:content_hub_validate_article",
      "valueInstructions": "set:config.loading,when,\"all:varEq,remoteStatus.contentHub.content_hub_validate_article.state,loading\",true,false"
    },
    {
      "id": "seoPublishButton",
      "type": "button",
      "config": {
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-accentColor ank-color-onSuccessColor ank-fontWeight-900 ank-border-0 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-gap-8px ank-textDecoration-none",
        "disabledClasses": "zlp-cursor-not-allowed ank-opacity-0_45 ank-bg-secondaryTextColor ank-color-bgColor",
        "loadingClasses": "zlp-cursor-wait ank-opacity-0_85",
        "label": "Publicar con SEO actual",
        "loadingLabel": "Publicando...",
        "disabledWhenInvalidScope": false,
        "iconPosition": "before"
      },
      "eventInstructions": "proxyAction:content_hub_publish_article",
      "valueInstructions": "set:config.loading,when,\"all:varEq,remoteStatus.contentHub.content_hub_publish_article.state,loading\",true,false"
    },
    {
      "id": "seoStatus",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-width-100per ank-bg-bgColor ank-border-1px__solid__textColorOPA__0_18 ank-borderRadius-8px ank-p-16px ank-display-flex ank-flexDirection-column ank-gap-10px",
        "components": [
          "seoValidateLoading",
          "seoValidateError",
          "seoValidateSuccess",
          "seoValidateArticleId",
          "seoValidateRevisionId",
          "seoPublishLoading",
          "seoPublishError",
          "seoPublishSuccess",
          "seoPublishArticleId",
          "seoPublishRevisionId"
        ]
      }
    },
    {
      "id": "seoValidateLoading",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Cargando...",
        "classes": "ank-m-0 ank-fontSize-14px ank-lineHeight-1_55 ank-color-secondaryTextColor ank-fontWeight-800"
      },
      "condition": "all:varEq,remoteStatus.contentHub.content_hub_validate_article.state,loading"
    },
    {
      "id": "seoValidateError",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "No se pudo completar la operación.",
        "classes": "ank-m-0 ank-p-12px ank-borderRadius-8px ank-bg-bgColor ank-border-1px__solid__errorColor ank-color-errorColor ank-fontWeight-900 ank-fontSize-13px"
      },
      "condition": "all:varEq,remoteStatus.contentHub.content_hub_validate_article.state,error",
      "valueInstructions": "set:config.text,varOr,remoteStatus.contentHub.content_hub_validate_article.error,No se pudo completar la operación."
    },
    {
      "id": "seoValidateSuccess",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Validación SEO completada.",
        "classes": "ank-m-0 ank-p-12px ank-borderRadius-8px ank-bg-bgColor ank-border-1px__solid__successColor ank-color-titleColor ank-fontWeight-900 ank-fontSize-13px"
      },
      "condition": "all:varEq,remoteStatus.contentHub.content_hub_validate_article.state,success"
    },
    {
      "id": "seoValidateArticleId",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "articleId pendiente",
        "classes": "ank-m-0 ank-fontSize-14px ank-lineHeight-1_55 ank-color-secondaryTextColor ank-fontWeight-700"
      },
      "condition": "all:varEq,remoteStatus.contentHub.content_hub_validate_article.state,success",
      "valueInstructions": "set:config.text,varOr,remoteStatus.contentHub.content_hub_validate_article.articleId,La respuesta no incluyó articleId."
