      "config": {
        "text": "Hub",
        "href": "/admin/blog/hub",
        "classes": "ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-bg-secondaryBgColor ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-textDecoration-none ank-display-flex ank-alignItems-center ank-justifyContent-center",
        "styles": {
          "minWidth": "max-content"
        }
      }
    },
    {
      "id": "admin-blog-programadosNavConfig",
      "type": "link",
      "config": {
        "text": "Configuración",
        "href": "/admin/blog/configuracion",
        "classes": "ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-bg-secondaryBgColor ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-textDecoration-none ank-display-flex ank-alignItems-center ank-justifyContent-center",
        "styles": {
          "minWidth": "max-content"
        }
      }
    },
    {
      "id": "scheduledScope",
      "type": "interaction-scope",
      "config": {
        "scopeId": "articleSchedule",
        "valueInstructions": "collectFields:articleId,revisionId,publishAt,unpublishAt,timezone,scheduleAction,publishMessage",
        "components": [
          "scheduledWorkspace"
        ]
      }
    },
    {
      "id": "scheduledWorkspace",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "ank-width-100per ank-bg-secondaryBgColor ank-border-1px__solid__textColorOPA__0_18 ank-borderRadius-8px ank-p-20px ank-display-flex ank-flexDirection-column ank-gap-14px",
        "components": [
          "scheduledArticleId",
          "scheduledGrid",
          "scheduledActions",
          "scheduledStatus",
          "scheduledTable"
        ]
      }
    },
    {
      "id": "scheduledArticleId",
      "type": "input",
      "config": {
        "fieldId": "articleId",
        "label": "Article ID",
        "controlType": "text",
        "helperText": "Se toma del query string articleId agregado al abrir desde la tabla.",
        "required": false,
        "readOnly": true,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-52px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px ank-fontWeight-700",
        "validation": []
      },
      "valueInstructions": "set:config.value,queryParamOr,articleId,"
    },
    {
      "id": "scheduledGrid",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-width-100per ank-display-grid ank-gap-14px",
        "styles": {
          "gridTemplateColumns": "repeat(auto-fit, minmax(min(100%, 220px), 1fr))"
        },
        "components": [
          "scheduledRevisionId",
          "scheduledPublishAt",
          "scheduledUnpublishAt",
          "scheduledTimezone",
          "scheduledAction",
          "scheduledMessage"
        ]
      }
    },
    {
      "id": "scheduledRevisionId",
      "type": "input",
      "config": {
        "fieldId": "revisionId",
        "label": "revisionId",
        "controlType": "text",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-52px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px ank-fontWeight-700",
        "validation": []
      }
    },
    {
      "id": "scheduledPublishAt",
      "type": "input",
      "config": {
        "fieldId": "publishAt",
        "label": "publishAt",
        "controlType": "text",
        "placeholder": "2026-06-24T09:00:00-06:00",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-52px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px ank-fontWeight-700",
        "validation": []
      }
    },
    {
      "id": "scheduledUnpublishAt",
      "type": "input",
      "config": {
        "fieldId": "unpublishAt",
        "label": "unpublishAt",
        "controlType": "text",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-52px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px ank-fontWeight-700",
        "validation": []
      }
    },
    {
      "id": "scheduledTimezone",
      "type": "input",
      "config": {
        "fieldId": "timezone",
        "label": "timezone",
        "controlType": "text",
        "value": "America/Mexico_City",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-52px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px ank-fontWeight-700",
        "validation": []
      }
    },
    {
      "id": "scheduledAction",
      "type": "input",
      "config": {
        "fieldId": "scheduleAction",
        "label": "scheduleAction",
        "controlType": "select",
        "value": "schedule",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "options": [
          {
            "value": "schedule",
            "label": "Programar"
          },
          {
            "value": "reschedule",
            "label": "Reprogramar"
          },
          {
            "value": "cancelSchedule",
            "label": "Cancelar"
          }
        ],
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-52px ank-px-16px ank-py-8px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_22 ank-bg-bgColor ank-color-titleColor ank-fontSize-15px ank-fontWeight-900 ank-display-flex ank-alignItems-center ank-justifyContent-spaceBetween ank-boxShadow-0_8px_20px_rgbaSD0C0C0C__0_08ED",
        "dropdownTriggerClasses": "ank-width-100per ank-minHeight-52px ank-display-flex ank-alignItems-center ank-justifyContent-spaceBetween ank-gap-12px",
        "dropdownTriggerTextConfig": {
          "classes": "ank-display-block ank-overflow-hidden ank-textOverflow-ellipsis ank-whiteSpace-nowrap ank-textAlign-left"
        },
        "dropdownIndicatorText": "▼",
        "dropdownIndicatorClasses": "zlp-dropdown-caret ank-fontSize-12px ank-fontWeight-900 ank-lineHeight-1 ank-color-accentColor ank-marginLeft-auto ank-flexShrink-0",
        "optionContainerClasses": "ank-display-flex ank-flexDirection-column ank-gap-8px",
        "optionClasses": "ank-width-100per ank-p-12px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-titleColor ank-textAlign-left ank-cursor-pointer",
        "activeOptionClasses": "ank-bg-accentColor ank-color-onSuccessColor",
        "validation": [],
        "fieldClasses": "ank-width-100per",
        "dropdownConfig": {
          "overlayMatchWidth": "origin",
          "overlayOffsetY": 8,
          "menuContainerClasses": "ank-bg-bgColor ank-border-1px__solid__textColorOPA__0_22 ank-borderRadius-8px ank-boxShadow-0_18px_45px_rgbaSD0C0C0C__0_20ED ank-p-6px ank-zIndex-1400",
          "menuNavClasses": "ank-width-100per",
          "menuListClasses": "ank-listStyle-none ank-m-0 ank-p-0 ank-display-flex ank-flexDirection-column ank-gap-4px",
          "itemLinkClasses": "ank-display-flex ank-alignItems-center ank-justifyContent-spaceBetween ank-minHeight-46px ank-px-14px ank-borderRadius-8px ank-color-titleColor ank-textDecoration-none ank-fontWeight-900 ank-bg-transparent",
          "selectedItemClasses": "ank-bg-accentColor ank-color-onSuccessColor",
          "disabledItemClasses": "ank-opacity-0_45 ank-cursor-notAllowed"
        }
      }
    },
    {
      "id": "scheduledMessage",
      "type": "input",
      "config": {
        "fieldId": "publishMessage",
        "label": "Mensaje interno",
        "controlType": "text",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-52px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px ank-fontWeight-700",
        "validation": []
      }
    },
    {
      "id": "scheduledActions",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-flexWrap-wrap ank-gap-12px",
        "components": [
          "scheduledScheduleButton",
          "scheduledPublishButton"
        ]
      }
    },
    {
      "id": "scheduledScheduleButton",
      "type": "button",
      "config": {
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-accentColor ank-color-onSuccessColor ank-fontWeight-900 ank-border-0 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-gap-8px ank-textDecoration-none",
        "disabledClasses": "zlp-cursor-not-allowed ank-opacity-0_45 ank-bg-secondaryTextColor ank-color-bgColor",
        "loadingClasses": "zlp-cursor-wait ank-opacity-0_85",
        "label": "Guardar programación",
        "loadingLabel": "Guardando...",
        "disabledWhenInvalidScope": false,
        "iconPosition": "before"
      },
      "eventInstructions": "proxyAction:content_hub_schedule_article",
      "valueInstructions": "set:config.loading,when,\"all:varEq,remoteStatus.contentHub.content_hub_schedule_article.state,loading\",true,false"
    },
    {
      "id": "scheduledPublishButton",
      "type": "button",
      "config": {
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-accentColor ank-color-onSuccessColor ank-fontWeight-900 ank-border-0 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-gap-8px ank-textDecoration-none",
        "disabledClasses": "zlp-cursor-not-allowed ank-opacity-0_45 ank-bg-secondaryTextColor ank-color-bgColor",
        "loadingClasses": "zlp-cursor-wait ank-opacity-0_85",
        "label": "Publicar ahora",
        "loadingLabel": "Publicando...",
        "disabledWhenInvalidScope": false,
        "iconPosition": "before"
      },
      "eventInstructions": "proxyAction:content_hub_publish_article",
      "valueInstructions": "set:config.loading,when,\"all:varEq,remoteStatus.contentHub.content_hub_publish_article.state,loading\",true,false"
    },
    {
      "id": "scheduledStatus",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-width-100per ank-bg-bgColor ank-border-1px__solid__textColorOPA__0_18 ank-borderRadius-8px ank-p-16px ank-display-flex ank-flexDirection-column ank-gap-10px",
        "components": [
          "scheduledScheduleLoading",
          "scheduledScheduleError",
          "scheduledScheduleSuccess",
          "scheduledScheduleArticleId",
          "scheduledScheduleRevisionId",
          "scheduledPublishLoading",
          "scheduledPublishError",
          "scheduledPublishSuccess",
          "scheduledPublishArticleId",
          "scheduledPublishRevisionId"
        ]
      }
    },
    {
      "id": "scheduledScheduleLoading",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Cargando...",
        "classes": "ank-m-0 ank-fontSize-14px ank-lineHeight-1_55 ank-color-secondaryTextColor ank-fontWeight-800"
      },
      "condition": "all:varEq,remoteStatus.contentHub.content_hub_schedule_article.state,loading"
    },
    {
      "id": "scheduledScheduleError",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "No se pudo completar la operación.",
        "classes": "ank-m-0 ank-p-12px ank-borderRadius-8px ank-bg-bgColor ank-border-1px__solid__errorColor ank-color-errorColor ank-fontWeight-900 ank-fontSize-13px"
      },
      "condition": "all:varEq,remoteStatus.contentHub.content_hub_schedule_article.state,error",
      "valueInstructions": "set:config.text,varOr,remoteStatus.contentHub.content_hub_schedule_article.error,No se pudo completar la operación."
    },
    {
      "id": "scheduledScheduleSuccess",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Programación actualizada.",
        "classes": "ank-m-0 ank-p-12px ank-borderRadius-8px ank-bg-bgColor ank-border-1px__solid__successColor ank-color-titleColor ank-fontWeight-900 ank-fontSize-13px"
      },
      "condition": "all:varEq,remoteStatus.contentHub.content_hub_schedule_article.state,success"
    },
    {
      "id": "scheduledScheduleArticleId",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "articleId pendiente",
        "classes": "ank-m-0 ank-fontSize-14px ank-lineHeight-1_55 ank-color-secondaryTextColor ank-fontWeight-700"
      },
      "condition": "all:varEq,remoteStatus.contentHub.content_hub_schedule_article.state,success",
      "valueInstructions": "set:config.text,varOr,remoteStatus.contentHub.content_hub_schedule_article.articleId,La respuesta no incluyó articleId."
    },
    {
      "id": "scheduledScheduleRevisionId",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "revisionId pendiente",
        "classes": "ank-m-0 ank-fontSize-14px ank-lineHeight-1_55 ank-color-secondaryTextColor ank-fontWeight-700"
      },
      "condition": "all:varEq,remoteStatus.contentHub.content_hub_schedule_article.state,success",
      "valueInstructions": "set:config.text,varOr,remoteStatus.contentHub.content_hub_schedule_article.revisionId,La respuesta no incluyó revisionId."
    },
    {
      "id": "scheduledPublishLoading",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Cargando...",
        "classes": "ank-m-0 ank-fontSize-14px ank-lineHeight-1_55 ank-color-secondaryTextColor ank-fontWeight-800"
      },
      "condition": "all:varEq,remoteStatus.contentHub.content_hub_publish_article.state,loading"
    },
    {
      "id": "scheduledPublishError",
      "type": "text",
