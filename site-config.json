{
  "version": 1,
  "domain": "zoositioweb.com.mx",
  "aliases": [
    "zoositioweb.com"
  ],
  "defaultPageId": "default",
  "notFoundPageId": "not-found",
  "routes": [
    {
      "path": "/",
      "pageId": "default",
      "label": "Inicio"
    },
    {
      "path": "/acceso",
      "pageId": "acceso",
      "label": "Acceso"
    },
    {
      "path": "/registro",
      "pageId": "registro",
      "label": "Crear cuenta"
    },
    {
      "path": "/confirmar-cuenta",
      "pageId": "confirmar-cuenta",
      "label": "Confirmar cuenta"
    },
    {
      "path": "/recuperar-contrasena",
      "pageId": "recuperar-contrasena",
      "label": "Recuperar contraseña"
    },
    {
      "path": "/cambiar-contrasena",
      "pageId": "cambiar-contrasena",
      "label": "Cambiar contraseña"
    },
    {
      "path": "/auth/callback",
      "pageId": "auth-callback",
      "label": "Auth callback"
    },
    {
      "path": "/mi-cuenta",
      "pageId": "mi-cuenta",
      "label": "Mi cuenta",
      "auth": {
        "required": true,
        "redirectTo": "/acceso",
        "allowedGroups": [
          "zoosite-client",
          "zoosite-admin"
        ]
      }
    },
    {
      "path": "/admin/usuarios",
      "pageId": "admin-usuarios",
      "label": "Administrar usuarios",
      "auth": {
        "required": true,
        "redirectTo": "/acceso",
        "allowedGroups": [
          "zoosite-admin"
        ]
      }
    },
    {
      "path": "/servicios",
      "pageId": "servicios",
      "label": "Servicios"
    },
    {
      "path": "/planes",
      "pageId": "planes",
      "label": "Planes"
    },
    {
      "path": "/sitios-web-para-pymes",
      "pageId": "sitios-web-para-pymes",
      "label": "Sitios Web para PyMEs"
    },
    {
      "path": "/plataforma",
      "pageId": "plataforma",
      "label": "Plataforma"
    },
    {
      "path": "/nosotros",
      "pageId": "nosotros",
      "label": "Nosotros"
    },
    {
      "path": "/preguntas-frecuentes",
      "pageId": "preguntas-frecuentes",
      "label": "Preguntas frecuentes"
    },
    {
      "path": "/contacto",
      "pageId": "contacto",
      "label": "Contacto"
    },
    {
      "path": "/privacidad",
      "pageId": "privacidad",
      "label": "Aviso de privacidad"
    },
    {
      "path": "/terminos",
      "pageId": "terminos",
      "label": "Términos y condiciones"
    },
    {
      "path": "/404",
      "pageId": "not-found",
      "label": "Página no encontrada"
    },
    {
      "path": "/sectores/consultorios",
      "pageId": "sector-consultorios",
      "label": "Consultorios médicos"
    },
    {
      "path": "/sectores/despachos",
      "pageId": "sector-despachos",
      "label": "Despachos de abogados"
    },
    {
      "path": "/sectores/inmobiliarias",
      "pageId": "sector-inmobiliarias",
      "label": "Inmobiliarias"
    },
    {
      "path": "/sectores/servicios-locales",
      "pageId": "sector-servicios-locales",
      "label": "Servicios locales"
    },
    {
      "path": "/sectores/constructoras",
      "pageId": "sector-constructoras",
      "label": "Empresas constructoras"
    },
    {
      "path": "/sectores/agencias",
      "pageId": "sector-agencias",
      "label": "Agencias de marketing digital"
    }
  ],
  "sitemap": {
    "excludePaths": [
      "/404",
      "/acceso",
      "/registro",
      "/confirmar-cuenta",
      "/recuperar-contrasena",
      "/cambiar-contrasena",
      "/auth/callback",
      "/mi-cuenta",
      "/admin/usuarios"
    ]
  },
  "site": {
    "theme": {
      "defaultMode": "light",
      "palettes": {
        "light": {
          "bgColor": "#ece7df",
          "textColor": "#17202a",
          "titleColor": "#0d141c",
          "linkColor": "#214c72",
          "accentColor": "#128c7e",
          "secondaryBgColor": "#bcc1ba",
          "secondaryTextColor": "#2f3b36",
          "secondaryTitleColor": "#111827",
          "secondaryLinkColor": "#214c72",
          "secondaryAccentColor": "#ff6b57",
          "successColor": "#128c7e",
          "onSuccessColor": "#06110f",
          "errorColor": "#dc3545",
          "onErrorColor": "#3b0a10",
          "warningColor": "#f59e0b",
          "onWarningColor": "#3a2400",
          "infoColor": "#214c72",
          "onInfoColor": "#041b44"
        },
        "dark": {
          "bgColor": "#11161d",
          "textColor": "#edf3f8",
          "titleColor": "#ffffff",
          "linkColor": "#6097b5",
          "accentColor": "#25d366",
          "secondaryBgColor": "#1d2630",
          "secondaryTextColor": "#c2ccd6",
          "secondaryTitleColor": "#f7fbff",
          "secondaryLinkColor": "#6097b5",
          "secondaryAccentColor": "#ff8c7a",
          "successColor": "#128c7e",
          "onSuccessColor": "#06110f",
          "errorColor": "#ff7b89",
          "onErrorColor": "#31070c",
          "warningColor": "#f7c948",
          "onWarningColor": "#2a1f00",
          "infoColor": "#6097b5",
          "onInfoColor": "#071b33"
        }
      }
    },
    "appIdentity": {
      "identifier": "zoositiowebcommx",
      "name": "zoositioweb",
      "version": "1.0.0",
      "description": "Complete websites for businesses with guided WhatsApp contact, cloud architecture, and first-party measurement from day one."
    },
    "icons": {
      "favicon": "https://assets.zoolandingpage.com.mx/zoositioweb.com.mx/shared/brand/zoolandingpage-zoositioweb-default-favicon.svg",
      "maskIcon": "https://assets.zoolandingpage.com.mx/zoositioweb.com.mx/shared/brand/zoolandingpage-zoositioweb-default-favicon.svg",
      "themeColor": "#128c7e"
    },
    "seo": {
      "siteName": "zoositioweb",
      "title": "zoositioweb | Sitios web profesionales para negocios",
      "description": "Sitios web profesionales para negocios con contacto por WhatsApp, arquitectura en la nube, medición desde el inicio y análisis de datos propios.",
      "canonicalOrigin": "https://zoositioweb.com.mx",
      "enforceCanonicalHost": true,
      "forceHttps": true,
      "defaultImage": "https://assets.zoolandingpage.com.mx/zoolandingpage.com.mx/shared/seo-images/zoolandingpage-zoositioweb-default-logo-card.jpg",
      "openGraph": {
        "type": "website",
        "site_name": "zoositioweb",
        "image": "https://assets.zoolandingpage.com.mx/zoolandingpage.com.mx/shared/seo-images/zoolandingpage-zoositioweb-default-logo-card.jpg",
        "image:type": "image/jpeg",
        "image:width": "1200",
        "image:height": "630",
        "image:alt": "Zoo Sitio Web logo"
      },
      "twitter": {
        "card": "summary_large_image",
        "image": "https://assets.zoolandingpage.com.mx/zoolandingpage.com.mx/shared/seo-images/zoolandingpage-zoositioweb-default-logo-card.jpg",
        "image:alt": "Zoo Sitio Web logo"
      },
      "keywords": {
        "es": [
          "sitios web profesionales",
          "paginas web para pymes",
          "sitios web para negocios",
          "zoositioweb",
          "sitios web medibles",
          "sitios web con datos propios",
          "analitica web para negocios"
        ],
        "en": [
          "professional websites",
          "websites for small business",
          "business websites",
          "zoositioweb",
          "measurable websites",
          "websites with first-party data",
          "website analytics for business"
        ]
      },
      "robots": "index,follow,max-image-preview:large"
    },
    "hostOverrides": {
      "zoositioweb.com": {
        "seo": {
          "canonicalOrigin": "https://zoositioweb.com.mx",
          "enforceCanonicalHost": false,
          "forceHttps": true
        },
        "googleTag": {
          "enabled": true,
          "environments": {
            "local": false,
            "test": true,
            "production": true
          },
          "measurementIds": [
            "G-QRWR768FCM"
          ],
          "sendPageView": false,
          "attribution": {
            "storage": "session",
            "ttlDays": 90
          },
          "events": {
            "page_view": "page_view",
            "whatsapp_click": {
              "name": "lead_conversion_whatsapp",
              "params": {
                "pyme_id": "zoositiowebcommx"
              }
            },
            "cta_click": "cta_click",
            "nav_click": "nav_click",
            "scroll_depth": "scroll_depth"
          }
        }
      },
      "test.zoositioweb.com.mx": {
        "seo": {
          "canonicalOrigin": "https://zoositioweb.com.mx",
          "enforceCanonicalHost": false,
          "forceHttps": true
        },
        "googleTag": {
          "enabled": false,
          "environments": {
            "local": false,
            "test": false,
            "production": false
          },
          "sendPageView": false,
          "attribution": {
            "storage": "session",
            "ttlDays": 90
          },
          "events": {
            "page_view": "page_view",
            "whatsapp_click": {
              "name": "lead_conversion_whatsapp",
              "params": {
                "pyme_id": "zoositiowebcommx"
              }
            },
            "cta_click": "cta_click",
            "nav_click": "nav_click",
            "scroll_depth": "scroll_depth"
          }
        }
      }
    },
    "i18n": {
      "defaultLanguage": "es",
      "supportedLanguages": [
        {
          "code": "es",
          "label": "ES"
        },
        {
          "code": "en",
          "label": "EN"
        }
      ]
    }
  },
  "defaults": {
    "brand": {
      "displayName": "zoositioweb"
    },
    "ui": {
      "contact": {
        "whatsappPhone": "+525522699563",
        "whatsappMessageKey": "ui.contact.headerLabel"
      },
      "loadingCurtain": {
        "title": "Zoo Sitio Web",
        "subtitle": "zoositioweb.com.mx",
        "exitDurationMs": 420,
        "enabled": true,
        "logoUrl": "https://assets.zoolandingpage.com.mx/zoositioweb.com.mx/shared/brand/zoolandingpage-zoositioweb-default-favicon.svg",
        "background": "#ece7df",
        "foreground": "#0d141c",
        "accent": "#128c7e",
        "minVisibleMs": 0
      }
    }
  },
  "runtime": {
    "localStorage": {
      "theme": "zoositioweb-theme",
      "language": "zoositioweb-language",
      "userPreferences": "zoositioweb-preferences",
      "id": "zoositioweb-id",
      "sessionId": "zoositioweb-session-id",
      "allowAnalytics": "zoositioweb-allow-analytics",
      "analyticsConsentSnooze": "zoositioweb-allow-analytics-snooze",
      "adAttribution": "zoositioweb-ad-attribution",
      "pageViewCount": "zoositioweb-page-view-count"
    },
    "features": {
      "debugMode": false
    },
    "navigation": {
      "scrollRestoration": {
        "mode": "top",
        "behavior": "auto"
      }
    },
    "analytics": {
      "enabled": true,
      "consentUI": "none",
      "consentSnoozeSeconds": 30,
      "track": [
        "language",
        "platform",
        "screenWidth",
        "screenHeight",
        "timezone"
      ],
      "events": {
        "page_view": "page_view",
        "nav_click": "nav_click",
        "cta_click": "cta_click",
        "whatsapp_click": "whatsapp_click",
        "faq_open": "faq_open",
        "section_view": "section_view",
        "scroll_depth": "scroll_depth",
        "theme_toggle": "theme_toggle",
        "language_toggle": "language_toggle"
      },
      "categories": {
        "navigation": "navigation",
        "cta": "cta",
        "faq": "faq",
        "engagement": "engagement",
        "theme": "theme",
        "i18n": "i18n"
      },
      "quickStats": {
        "pageView": {
          "event": "page_view",
          "path": "metrics.pageViews",
          "by": 1
        },
        "events": [
          {
            "name": "whatsapp_click",
            "path": "metrics.whatsappClicks",
            "by": 1
          },
          {
            "name": "cta_click",
            "path": "metrics.ctaClicks",
            "by": 1
          }
        ]
      },
      "googleTag": {
        "enabled": true,
        "environments": {
          "local": false,
          "test": true,
          "production": true
        },
        "measurementIds": [
          "G-QRWR768FCM"
        ],
        "sendPageView": false,
        "attribution": {
          "storage": "session",
          "ttlDays": 90
        },
        "events": {
          "page_view": "page_view",
          "whatsapp_click": {
            "name": "lead_conversion_whatsapp",
            "params": {
              "pyme_id": "zoositiowebcommx"
            }
          },
          "cta_click": "cta_click",
          "nav_click": "nav_click",
          "scroll_depth": "scroll_depth"
        }
      }
    },
    "authRemote": {
      "enabled": true,
      "authProfileId": "staff",
      "endpoint": "/auth/runtime-config"
    },
    "dataSources": [
      {
        "id": "auth-account",
        "kind": "auth-admin",
        "authAdminSource": "account",
        "target": "remote.auth.account",
        "statusTarget": "remoteStatus.authAccount",
        "clearTargetOnLoad": true,
        "pageIds": [
          "mi-cuenta"
        ],
        "mapper": {
          "itemsPath": "account",
          "singleItem": true,
          "fields": {
            "email": {
              "path": "email",
              "fallback": "Correo no disponible"
            },
            "rolesText": {
              "path": "roles",
              "fallback": "Sin grupos"
            },
            "approvalStatus": {
              "path": "approvalStatus",
              "lookup": {
                "pending": "Pendiente de aprobación",
                "approved": "Aprobada",
                "rejected": "Rechazada",
                "suspended": "Suspendida"
              },
              "fallback": "Pendiente de aprobación"
            },
            "environment": {
              "path": "environment",
              "fallback": "prod"
            },
            "isAdminText": {
              "path": "isAdmin",
              "lookup": {
                "true": "Administrador",
                "false": "Cliente"
              },
              "fallback": "Cliente"
            }
          }
        }
      },
      {
        "id": "auth-admin-users",
        "kind": "auth-admin",
        "authAdminSource": "adminUsers",
        "target": "remote.auth.adminUsers",
        "statusTarget": "remoteStatus.adminUsers",
        "clearTargetOnLoad": true,
        "pageIds": [
          "admin-usuarios"
        ],
        "mapper": {
          "itemsPath": "users",
          "fields": {
            "email": {
              "path": "email",
              "fallback": "Correo no disponible"
            },
            "subject": {
              "path": "subject",
              "fallback": "Sin identificador"
            },
            "rolesText": {
              "path": "roles",
              "fallback": "Sin grupos"
            },
            "statusLabel": {
              "path": "approvalStatus",
              "lookup": {
                "pending": "Pendiente",
                "approved": "Aprobado",
                "rejected": "Rechazado",
                "suspended": "Suspendido"
              },
              "fallback": "Pendiente"
            },
            "enabledLabel": {
              "path": "enabled",
              "lookup": {
                "true": "Activo",
                "false": "Deshabilitado"
              },
              "fallback": "Activo"
            },
            "clientApproveInstructions": {
              "path": "subject",
              "prefix": "authAdminAction:approveUser,",
              "suffix": ",zoosite-client,remoteStatus.adminUsersAction"
            },
            "adminApproveInstructions": {
              "path": "subject",
              "prefix": "authAdminAction:approveUser,",
              "suffix": ",zoosite-client|zoosite-admin,remoteStatus.adminUsersAction"
            },
            "suspendInstructions": {
              "path": "subject",
              "prefix": "authAdminAction:suspendUser,",
              "suffix": ",,remoteStatus.adminUsersAction"
            },
            "reactivateInstructions": {
              "path": "subject",
              "prefix": "authAdminAction:reactivateUser,",
              "suffix": ",,remoteStatus.adminUsersAction"
            }
          }
        }
      }
    ]
  },
  "environments": {
    "test": {
      "aliases": [
        "test.zoositioweb.com.mx"
      ]
    }
  }
}
