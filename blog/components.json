{
  "version": 1,
  "domain": "zoositioweb.com.mx",
  "pageId": "blog",
  "components": [
    {
      "id": "blogRoot",
      "type": "container",
      "config": {
        "tag": "main",
        "classes": "ank-minHeight-100vh ank-bg-bgColor ank-color-textColor ank-display-flex ank-flexDirection-column ank-alignItems-center ank-gap-26px",
        "styles": {
          "padding": "clamp(18px, 3vw, 40px)"
        },
        "components": [
          "blogHeader",
          "blogDiscovery",
          "blogArticleList",
          "blogEmptyState",
          "blogFooterCta"
        ]
      }
    },
    {
      "id": "blogHeader",
      "type": "container",
      "config": {
        "tag": "header",
        "classes": "ank-width-100per ank-maxWidth-1040px ank-display-flex ank-flexDirection-column ank-gap-10px",
        "components": [
          "blogEyebrow",
          "blogTitle",
          "blogIntro"
        ]
      }
    },
    {
      "id": "blogEyebrow",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "ZOOSITIOWEB BLOG",
        "classes": "ank-m-0 ank-fontSize-13px ank-fontWeight-900 ank-letterSpacing-0 ank-color-accentColor"
      }
    },
    {
      "id": "blogTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,blog.title",
      "config": {
        "tag": "h1",
        "text": "Ideas para crear sitios web que se puedan publicar, medir y mejorar",
        "classes": "ank-m-0 ank-fontSize-40px ank-lineHeight-1_1 ank-fontWeight-900 ank-color-titleColor"
      }
    },
    {
      "id": "blogIntro",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,blog.intro",
      "config": {
        "tag": "p",
        "text": "Guías y recursos para crear sitios, contenido y herramientas digitales con mejor experiencia, medición y posicionamiento en buscadores.",
        "classes": "ank-m-0 ank-fontSize-17px ank-lineHeight-1_6 ank-color-secondaryTextColor ank-maxWidth-820px"
      }
    },
    {
      "id": "blogDiscovery",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "ank-width-100per ank-maxWidth-1040px ank-display-flex ank-flexDirection-column ank-gap-16px",
        "styles": {
          "alignItems": "stretch"
        },
        "components": [
          "blogFilterPanel",
          "blogTaxonomyPanel"
        ]
      }
    },
    {
      "id": "blogFilterPanel",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-width-100per ank-bg-secondaryBgColor ank-border-1px__solid__textColorOPA__0_18 ank-borderRadius-8px ank-p-20px ank-display-flex ank-flexDirection-column ank-gap-14px",
        "components": [
          "blogFilterTitle",
          "blogSearch",
          "blogCategoryLinks"
        ]
      }
    },
    {
      "id": "blogFilterTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,blog.exploreContent",
      "config": {
        "tag": "h2",
        "text": "Explorar contenido",
        "classes": "ank-m-0 ank-fontSize-20px ank-fontWeight-900 ank-color-titleColor"
      }
    },
    {
      "id": "blogSearch",
      "type": "search-box",
      "valueInstructions": "set:config.placeholder,i18n,blog.searchPlaceholder",
      "config": {
        "placeholder": "Buscar por tema, posicionamiento o categoría",
        "classes": "ank-width-100per ank-display-flex ank-alignItems-center",
        "inputClasses": "ank-width-100per ank-minHeight-52px ank-px-16px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_22 ank-bg-bgColor ank-color-textColor ank-fontSize-15px ank-fontWeight-700 ank-outline-none ank-boxSizing-borderBox",
        "resultsClasses": "ank-listStyle-none ank-m-0 ank-p-6px ank-display-flex ank-flexDirection-column ank-gap-4px ank-bg-bgColor ank-border-1px__solid__textColorOPA__0_18 ank-borderRadius-8px ank-boxShadow-0_18px_45px_rgbaSD0C0C0C__0_18ED",
        "resultItemClasses": "ank-width-100per ank-bg-transparent ank-border-0 ank-cursor-pointer ank-color-titleColor ank-px-12px ank-py-10px ank-textAlign-left ank-borderRadius-8px ank-fontWeight-800 ank-bgHover-secondaryBgColor"
      }
    },
    {
      "id": "blogCategoryLinks",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-flexWrap-wrap ank-gap-10px",
        "components": [
          "blogAllLink",
          "blogCategoryWebLink"
        ]
      }
    },
    {
      "id": "blogAllLink",
      "type": "link",
      "valueInstructions": "set:config.text,i18n,blog.all",
      "config": {
        "href": "/blog",
        "text": "Todos",
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-transparent ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-textDecoration-none",
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "minHeight": "44px",
          "padding": "10px 14px",
          "boxSizing": "border-box"
        }
      }
    },
    {
      "id": "blogCategoryWebLink",
      "type": "link",
      "config": {
        "href": "/blog/web",
        "text": "Web",
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-transparent ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-textDecoration-none",
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "minHeight": "44px",
          "padding": "10px 14px",
          "boxSizing": "border-box"
        }
      }
    },
    {
      "id": "blogTaxonomyPanel",
      "type": "container",
      "config": {
        "tag": "aside",
        "classes": "ank-width-100per ank-bg-secondaryBgColor ank-border-1px__solid__textColorOPA__0_18 ank-borderRadius-8px ank-p-20px ank-display-flex ank-flexDirection-column ank-gap-14px",
        "components": [
          "blogTaxonomyTitle",
          "blogTaxonomyGrid",
          "blogTagGrid"
        ]
      }
    },
    {
      "id": "blogTaxonomyTitle",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,blog.exploreByTopic",
      "config": {
        "tag": "h2",
        "text": "Explorar por tema",
        "classes": "ank-m-0 ank-fontSize-20px ank-fontWeight-900 ank-color-titleColor"
      }
    },
    {
      "id": "blogTaxonomyGrid",
      "type": "container",
      "loopConfig": {
        "source": "var",
        "path": "contentHub.categories.items",
        "templateId": "blogTaxonomyLinkTemplate",
        "idPrefix": "blogCategory",
        "bindings": [
          {
            "to": "config.href",
            "sources": [
              "path"
            ]
          },
          {
            "to": "config.text",
            "sources": [
              "label",
              "slug"
            ]
          }
        ]
      },
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-flexWrap-wrap ank-gap-8px",
        "components": []
      }
    },
    {
      "id": "blogTaxonomyLinkTemplate",
      "type": "link",
      "config": {
        "href": "/blog",
        "text": "Categoría",
        "classes": "ank-minHeight-48px ank-px-12px ank-borderRadius-8px ank-bg-bgColor ank-color-titleColor ank-fontWeight-900 ank-textDecoration-none ank-border-1px__solid__textColorOPA__0_18",
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "minHeight": "44px",
          "padding": "10px 14px",
          "boxSizing": "border-box"
        }
      }
    },
    {
      "id": "blogTagGrid",
      "type": "container",
      "loopConfig": {
        "source": "var",
        "path": "contentHub.tags.items",
        "templateId": "blogTagLinkTemplate",
        "idPrefix": "blogTag",
        "bindings": [
          {
            "to": "config.href",
            "sources": [
              "path",
              {
                "from": "slug",
                "prefix": "/blog/tag/"
              }
            ]
          },
          {
            "to": "config.text",
            "sources": [
              "label",
              "slug"
            ]
          }
        ]
      },
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-flexWrap-wrap ank-gap-8px",
        "components": []
      }
    },
    {
      "id": "blogTagLinkTemplate",
      "type": "link",
      "config": {
        "href": "/blog",
        "text": "Etiqueta",
        "classes": "ank-minHeight-48px ank-px-12px ank-borderRadius-8px ank-bg-bgColor ank-color-titleColor ank-fontWeight-900 ank-textDecoration-none ank-border-1px__solid__textColorOPA__0_18",
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "minHeight": "44px",
          "padding": "10px 14px",
          "boxSizing": "border-box"
        }
      }
    },
    {
      "id": "blogArticleList",
      "type": "container",
      "loopConfig": {
        "source": "var",
        "path": "contentHub.publicArticles.items",
        "templateId": "blogArticleCardTemplate",
        "idPrefix": "blogArticleCard",
        "bindings": [
          {
            "to": "config.title",
            "sources": [
              "title"
            ]
          },
          {
            "to": "config.description",
            "sources": [
              "summary"
            ]
          },
          {
            "to": "config.href",
            "sources": [
              "path"
            ]
          },
          {
            "to": "config.linkLabel",
            "sources": [
              {
                "from": "readLabel",
                "fallback": "Leer artículo"
              }
            ]
          },
          {
            "to": "config.linkEventInstructions",
            "sources": [
              {
                "from": "articleId",
                "prefix": "trackEvent:blog_cta_click,blog,blog-list-card,hubId,zoosite-main,articleId,",
                "suffix": ",ctaId,card-read"
              }
            ]
          },
          {
            "to": "config.imageSrc",
            "sources": [
              "imageSrc",
              "coverImage",
              "heroImage"
            ],
            "fallback": "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=900&q=80"
          },
          {
            "to": "config.imageAlt",
            "sources": [
              "imageAlt",
              "title"
            ],
            "fallback": "Portada del artículo"
          }
        ]
      },
      "config": {
        "tag": "section",
        "classes": "ank-width-100per ank-maxWidth-1040px ank-display-grid ank-gap-16px",
        "styles": {
          "alignItems": "stretch",
          "gridAutoRows": "1fr",
          "gridTemplateColumns": "repeat(auto-fit, minmax(min(100%, 300px), 1fr))"
        },
        "components": []
      }
    },
    {
      "id": "blogArticleCardTemplate",
      "type": "generic-card",
      "valueInstructions": "set:config.linkLabel,i18n,blog.readArticle",
      "config": {
        "variant": "feature",
        "title": "",
        "description": "",
        "href": "",
        "linkLabel": "Leer artículo",
        "imageSrc": "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=900&q=80",
        "imageAlt": "Portada del artículo",
        "classes": "ank-width-100per ank-height-100per ank-borderRadius-8px ank-bg-secondaryBgColor ank-border-1px__solid__textColorOPA__0_10 ank-p-22px ank-display-flex ank-flexDirection-column ank-gap-12px ank-overflow-hidden",
        "imageContainerClasses": "ank-width-100per ank-height-180px ank-overflow-hidden ank-borderRadius-8px ank-bg-bgColor",
        "imageClasses": "ank-width-100per ank-height-100per ank-display-block ank-objectFit-cover",
        "featureIconContainerClasses": "ank-display-flex ank-alignItems-center ank-justifyContent-center ank-width-42px ank-height-42px ank-borderRadius-8px ank-bg-bgColor ank-color-accentColor ank-border-1px__solid__textColorOPA__0_10 ank-marginBottom-12px",
        "featureIconClasses": "ank-display-block ank-width-24px ank-height-24px ank-color-accentColor",
        "featureTitleClasses": "ank-m-0 ank-fontSize-24px ank-lineHeight-1_2 ank-fontWeight-900 ank-color-titleColor",
        "featureDescriptionClasses": "ank-m-0 ank-fontSize-15px ank-lineHeight-1_6 ank-color-secondaryTextColor",
        "linkClasses": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-successColor ank-color-onSuccessColor ank-fontWeight-900 ank-border-0 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-gap-8px ank-textDecoration-none",
        "linkStyles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "minHeight": "44px",
          "padding": "10px 14px",
          "marginTop": "auto",
          "boxSizing": "border-box"
        }
      }
    },
    {
      "id": "blogEmptyState",
      "type": "text",
      "valueInstructions": "set:config.text,i18n,blog.emptyState",
      "config": {
        "tag": "p",
        "text": "Aún no hay artículos publicados para este filtro. Prueba otra búsqueda o vuelve más tarde para revisar nuevas guías.",
        "classes": "ank-width-100per ank-maxWidth-1040px ank-m-0 ank-p-16px ank-borderRadius-8px ank-bg-secondaryBgColor ank-color-secondaryTextColor ank-fontWeight-800"
      },
      "condition": "all:varLenEq,contentHub.publicArticles.items,0"
    },
    {
      "id": "blogFooterCta",
      "type": "link",
      "valueInstructions": "set:config.text,i18n,blog.footerCta",
      "config": {
        "href": "/blogs",
        "text": "Hablar sobre mi blog",
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-transparent ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-textDecoration-none",
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "minHeight": "44px",
          "padding": "10px 14px",
          "boxSizing": "border-box"
        }
      }
    }
  ]
}
