      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-width-100per ank-display-grid ank-gap-14px",
        "styles": {
          "gridTemplateColumns": "repeat(auto-fit, minmax(min(100%, 220px), 1fr))"
        },
        "components": [
          "tagsTaxonomyId",
          "tagsKind",
          "tagsSlug",
          "tagsTranslation",
          "tagsSeoDescription",
          "tagsVisible",
          "tagsRedirectWarning"
        ]
      }
    },
