    {
      "id": "tagsScope",
      "type": "interaction-scope",
      "config": {
        "scopeId": "tagsTaxonomy",
        "valueInstructions": "collectFields:taxonomyId,taxonomyKind,slug,translation,seoDescription,visible,redirectWarning",
        "components": [
          "tagsWorkspace"
        ]
      }
    },
    {
      "id": "tagsWorkspace",
      "type": "container",
      "config": {
