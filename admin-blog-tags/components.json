      "config": {
        "fieldId": "redirectWarning",
        "label": "redirectWarning",
        "controlType": "text",
        "required": false,
        "readOnly": false,
        "disabled": false,
        "classes": "ank-width-100per ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-900 ank-color-titleColor",
        "helperTextClasses": "ank-m-0 ank-fontSize-12px ank-lineHeight-1_45 ank-color-secondaryTextColor",
        "errorClasses": "ank-mt-4px ank-color-errorColor ank-fontWeight-800 ank-fontSize-12px",
        "inputClasses": "ank-width-100per ank-minHeight-48px ank-px-14px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-bgColor ank-color-textColor ank-fontSize-15px",
        "validation": []
      }
    },
    {
      "id": "tagsSaveNotice",
      "type": "button",
      "config": {
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-accentColor ank-color-onSuccessColor ank-fontWeight-900 ank-border-0 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-gap-8px ank-textDecoration-none",
        "disabledClasses": "zlp-cursor-not-allowed ank-opacity-0_45 ank-bg-secondaryTextColor ank-color-bgColor",
        "loadingClasses": "zlp-cursor-wait ank-opacity-0_85",
        "label": "Guardar tag",
        "loadingLabel": "Guardando...",
        "disabledWhenInvalidScope": false,
        "iconPosition": "before"
      },
      "eventInstructions": "proxyAction:content_hub_upsert_taxonomy",
      "valueInstructions": "set:config.loading,when,\"all:varEq,remoteStatus.contentHub.content_hub_upsert_taxonomy.state,loading\",true,false"
    },
    {
      "id": "tagsTable",
      "type": "generic-table",
      "config": {
        "id": "tagsTable",
        "label": "Tags",
        "rowsSource": {
          "source": "var",
          "path": "remote.contentHub.taxonomy.items"
        },
        "rows": [],
        "rowIdPath": "taxonomyId",
        "eventPayloadFields": [
          "articleId",
          "status",
          "latestRevisionId",
          "path"
        ],
        "emptyText": "No hay registros reales disponibles desde content-hub para este filtro.",
        "loadingText": "Cargando datos de content-hub...",
        "errorText": "No se pudieron cargar los datos protegidos. Revisa sesión, permisos o conectividad del BFF.",
        "columns": [
          {
            "id": "taxonomyId",
            "header": "ID",
            "valuePath": "taxonomyId"
          },
          {
            "id": "kind",
            "header": "Tipo",
            "valuePath": "kind"
          },
          {
            "id": "slug",
            "header": "slug",
            "valuePath": "slug"
          },
          {
            "id": "translation",
            "header": "translation",
            "valuePath": "label"
          },
          {
            "id": "seoDescription",
            "header": "seoDescription",
            "valuePath": "seoDescription"
          },
          {
            "id": "visible",
            "header": "visible",
            "valuePath": "visible"
          },
          {
            "id": "redirectWarning",
            "header": "redirectWarning",
            "valuePath": "redirectWarning"
          }
        ],
        "rowActions": [],
        "pagination": {
          "enabled": true,
          "pageSize": 10,
          "pageSizeOptions": [
            10,
            20,
            50
          ],
          "showFirstLastButtons": true
        },
        "classes": "ank-width-100per",
        "labelClasses": "ank-fontSize-18px ank-fontWeight-900 ank-color-titleColor",
        "stateClasses": "ank-p-16px ank-borderRadius-8px ank-bg-bgColor ank-color-secondaryTextColor ank-fontWeight-800",
        "actionButtonClasses": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-transparent ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-textDecoration-none"
      },
      "valueInstructions": "set:config.loading,when,\"all:varEq,remoteStatus.contentHub.taxonomy.state,loading\",true,false; set:config.error,var,remoteStatus.contentHub.taxonomy.error"
    }
  ]
}
