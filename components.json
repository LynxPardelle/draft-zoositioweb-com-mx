        "components": [
          "headerNav",
          "headerCtaLink",
          "toggleThemeDesktop",
          "toggleLanguageDesktop"
        ]
      }
    },
    {
      "id": "headerNav",
      "type": "container",
      "valueInstructions": "set:config.ariaLabel,i18n,ui.accessibility.primaryNavigation",
      "config": {
        "tag": "nav",
        "ariaLabel": "",
        "classes": "ank-display-none ank-display-md-flex ank-flexWrap-wrap ank-gap-14px ank-gap-md-18px ank-alignItems-center",
        "components": [
          "headerNavLinks"
        ]
      }
    },
    {
      "id": "headerNavLinkTemplate",
      "type": "link",
      "eventInstructions": "trackEvent:nav_click,navigation,event.eventData,href,event.eventData",
      "config": {
        "href": "",
        "text": "",
        "classes": "ank-color-textColor ank-textDecoration-none ank-fontWeight-700 ank-fontSize-0_94rem"
      }
    },
    {
      "id": "headerNavLinks",
      "type": "container",
      "condition": "all:navigation,exists",
      "loopConfig": {
        "source": "var",
        "path": "navigation",
        "templateId": "headerNavLinkTemplate",
        "idPrefix": "headerNavLink",
        "bindings": [
          {
            "to": "config.href",
            "sources": [
              "href",
              "url",
              {
                "from": "value",
                "transform": "navigationHref"
              }
            ]
          },
          {
            "to": "config.text",
            "sources": [
              {
                "from": "labelKey",
                "transform": "i18nKey"
              },
              {
                "from": "label",
                "transform": "locale"
              }
            ]
          },
          {
            "to": "config.ariaLabel",
            "sources": [
              {
                "from": "ariaLabelKey",
                "transform": "i18nKey"
              },
              {
                "from": "labelKey",
                "transform": "i18nKey"
              },
              {
                "from": "label",
                "transform": "locale"
              }
            ]
          }
        ]
      },
      "config": {
        "tag": "div",
        "classes": "ank-display-none ank-display-md-flex ank-flexWrap-wrap ank-gap-14px ank-gap-md-18px ank-alignItems-center",
        "components": []
      }
    },
    {
      "id": "headerCtaLink",
      "type": "link",
      "eventInstructions": "trackEvent:whatsapp_click,cta,header,location,header",
