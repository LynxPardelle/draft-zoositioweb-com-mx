{
  "version": 1,
  "domain": "zoositioweb.com.mx",
  "pageId": "blog-category",
  "components": [
    {
      "id": "blogCategoryRoot",
      "type": "container",
      "config": {
        "tag": "main",
        "classes": "ank-minHeight-100vh ank-bg-bgColor ank-color-textColor ank-display-flex ank-flexDirection-column ank-alignItems-center ank-gap-22px",
        "styles": {
          "padding": "clamp(18px, 3vw, 40px)"
        },
        "components": [
          "blogCategoryHeader",
          "blogCategoryTaxonomy",
          "blogCategoryList",
          "blogCategoryEmpty",
          "blogCategoryBack"
        ]
      }
    },
    {
      "id": "blogCategoryHeader",
      "type": "container",
      "config": {
        "tag": "header",
        "classes": "ank-width-100per ank-maxWidth-980px ank-display-flex ank-flexDirection-column ank-gap-10px",
        "components": [
          "blogCategoryEyebrow",
          "blogCategoryTitle",
          "blogCategoryText"
        ]
      }
    },
    {
      "id": "blogCategoryEyebrow",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "CATEGORÍA / ETIQUETA",
        "classes": "ank-m-0 ank-fontSize-13px ank-fontWeight-900 ank-color-accentColor"
      }
    },
    {
      "id": "blogCategoryTitle",
      "type": "text",
      "config": {
        "tag": "h1",
        "text": "Contenido publicado",
        "classes": "ank-m-0 ank-fontSize-38px ank-fontWeight-900 ank-color-titleColor"
      }
    },
    {
      "id": "blogCategoryText",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Las categorías y etiquetas públicas organizan los artículos por tema. Los filtros con múltiples etiquetas sólo deben indexarse cuando el sitio lo permita.",
        "classes": "ank-m-0 ank-fontSize-16px ank-lineHeight-1_6 ank-color-secondaryTextColor"
      }
    },
    {
      "id": "blogCategoryTaxonomy",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "ank-width-100per ank-maxWidth-980px ank-display-flex ank-flexWrap-wrap ank-gap-10px",
        "components": [
          "blogCategoryWeb",
          "blogTagSeo",
          "blogTagBuilder",
          "blogTagAngora"
        ]
      }
    },
    {
      "id": "blogCategoryWeb",
      "type": "link",
      "config": {
        "href": "/blog/web",
        "text": "Web",
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-transparent ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-textDecoration-none",
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "minHeight": "48px",
          "padding": "10px 18px",
          "boxSizing": "border-box"
        }
      }
    },
    {
      "id": "blogTagSeo",
      "type": "link",
      "config": {
        "href": "/blog/tag/seo",
        "text": "SEO",
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-transparent ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-textDecoration-none",
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "minHeight": "48px",
          "padding": "10px 18px",
          "boxSizing": "border-box"
        }
      }
    },
    {
      "id": "blogTagBuilder",
      "type": "link",
      "config": {
        "href": "/blog/tag/builder",
        "text": "Editor visual",
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-transparent ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-textDecoration-none",
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "minHeight": "48px",
          "padding": "10px 18px",
          "boxSizing": "border-box"
        }
      }
    },
    {
      "id": "blogTagAngora",
      "type": "link",
      "config": {
        "href": "/blog/tag/angora",
        "text": "Diseño del sitio",
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-transparent ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-textDecoration-none",
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "minHeight": "48px",
          "padding": "10px 18px",
          "boxSizing": "border-box"
        }
      }
    },
    {
      "id": "blogCategoryList",
      "type": "container",
      "loopConfig": {
        "source": "var",
        "path": "contentHub.publicArticles.items",
        "templateId": "blogCategoryArticleTemplate",
        "idPrefix": "blogCategoryArticle",
        "bindings": [
          {
            "to": "config.title",
            "sources": [
              "title"
            ]
          },
          {
            "to": "config.description",
            "sources": [
              "summary"
            ]
          },
          {
            "to": "config.href",
            "sources": [
              "path"
            ]
          },
          {
            "to": "config.linkLabel",
            "sources": [
              {
                "from": "readLabel",
                "fallback": "Leer artículo"
              }
            ]
          },
          {
            "to": "config.imageSrc",
            "sources": [
              "imageSrc",
              "coverImage",
              "heroImage"
            ],
            "fallback": "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=900&q=80"
          },
          {
            "to": "config.imageAlt",
            "sources": [
              "imageAlt",
              "title"
            ],
            "fallback": "Portada del artículo"
          }
        ]
      },
      "config": {
        "tag": "section",
        "classes": "ank-width-100per ank-maxWidth-980px ank-display-grid ank-gap-16px",
        "styles": {
          "alignItems": "stretch",
          "gridAutoRows": "1fr",
          "gridTemplateColumns": "repeat(auto-fit, minmax(min(100%, 300px), 1fr))"
        },
        "components": []
      }
    },
    {
      "id": "blogCategoryArticleTemplate",
      "type": "generic-card",
      "config": {
        "variant": "feature",
        "title": "",
        "description": "",
        "href": "",
        "linkLabel": "Leer artículo",
        "imageSrc": "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=900&q=80",
        "imageAlt": "Portada del artículo",
        "classes": "ank-width-100per ank-height-100per ank-borderRadius-8px ank-bg-secondaryBgColor ank-border-1px__solid__textColorOPA__0_10 ank-p-22px ank-display-flex ank-flexDirection-column ank-gap-12px ank-overflow-hidden",
        "imageContainerClasses": "ank-width-100per ank-height-180px ank-overflow-hidden ank-borderRadius-8px ank-bg-bgColor",
        "imageClasses": "ank-width-100per ank-height-100per ank-display-block ank-objectFit-cover",
        "featureTitleClasses": "ank-m-0 ank-fontSize-24px ank-lineHeight-1_2 ank-fontWeight-900 ank-color-titleColor",
        "featureDescriptionClasses": "ank-m-0 ank-fontSize-15px ank-lineHeight-1_6 ank-color-secondaryTextColor",
        "linkClasses": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-accentColor ank-color-onSuccessColor ank-fontWeight-900 ank-border-0 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-gap-8px ank-textDecoration-none",
        "linkStyles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "minHeight": "48px",
          "padding": "10px 18px",
          "marginTop": "auto",
          "boxSizing": "border-box"
        }
      }
    },
    {
      "id": "blogCategoryEmpty",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Aún no hay artículos publicados para este tema. Prueba otra categoría o vuelve más tarde.",
        "classes": "ank-width-100per ank-maxWidth-980px ank-m-0 ank-p-16px ank-borderRadius-8px ank-bg-secondaryBgColor ank-color-secondaryTextColor ank-fontWeight-800"
      },
      "condition": "all:varLenEq,contentHub.publicArticles.items,0"
    },
    {
      "id": "blogCategoryBack",
      "type": "link",
      "config": {
        "href": "/blog",
        "text": "Volver al blog",
        "classes": "ank-minHeight-48px ank-px-18px ank-borderRadius-8px ank-bg-transparent ank-color-titleColor ank-fontWeight-900 ank-border-1px__solid__textColorOPA__0_18 ank-cursor-pointer ank-display-inline-flex ank-alignItems-center ank-justifyContent-center ank-textDecoration-none",
        "styles": {
          "display": "inline-flex",
          "alignItems": "center",
          "justifyContent": "center",
          "minHeight": "48px",
          "padding": "10px 18px",
          "boxSizing": "border-box"
        }
      }
    }
  ]
}
