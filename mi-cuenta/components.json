          "miCuentaHomeLink"
        ]
      }
    },
    {
      "id": "miCuentaLogoutButton",
      "type": "button",
      "valueInstructions": "set:config.loading,when,\"all:varEq,authForm.logout.state,loading\",true,false",
      "eventInstructions": "authFormAction:logout,authForm.logout;trackEvent:auth_logout_click,auth,zoosite-logout,location,account_page",
      "config": {
        "type": "button",
        "label": "Cerrar sesión",
        "loadingLabel": "Cerrando sesión...",
        "ariaLabel": "Cerrar sesión en zoositioweb",
        "classes": "ank-width-100per ank-minHeight-48px ank-display-flex ank-alignItems-center ank-justifyContent-center ank-gap-8px ank-paddingInline-16px ank-paddingBlock-12px ank-border-1px__solid__secondaryAccentColor ank-borderRadius-8px ank-bg-secondaryBgColor ank-color-titleColor ank-fontSize-15px ank-fontWeight-900 ank-cursor-pointer",
        "loadingClasses": "zlp-cursor-wait ank-opacity-0_85",
        "spinnerClasses": "zlp-button-spinner"
      }
    },
    {
      "id": "miCuentaHomeLink",
      "type": "link",
      "config": {
        "href": "/",
        "text": "Volver al sitio",
        "ariaLabel": "Volver al inicio de zoositioweb",
        "classes": "ank-width-100per ank-display-flex ank-alignItems-center ank-justifyContent-center ank-minHeight-48px ank-paddingInline-16px ank-paddingBlock-12px ank-borderRadius-8px ank-bg-transparent ank-color-titleColor ank-fontSize-15px ank-fontWeight-800 ank-textDecoration-none ank-border-1px__solid__textColorOPA__0_10 ank-textAlign-center",
        "scrollRestoration": {
          "mode": "top"
        }
      }
    },
    {
      "id": "miCuentaFooter",
      "type": "text",
