{
  "version": 1,
  "domain": "zoositioweb.com.mx",
  "pageId": "mi-cuenta",
  "components": [
    {
      "id": "miCuentaRoot",
      "type": "container",
      "config": {
        "tag": "main",
        "classes": "ank-minHeight-100vh ank-display-flex ank-flexDirection-column ank-alignItems-center ank-justifyContent-center ank-gap-24px ank-p-24px ank-bg-bgColor ank-color-textColor",
        "components": [
          "miCuentaShell",
          "miCuentaFooter"
        ]
      }
    },
    {
      "id": "miCuentaShell",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "ank-width-100per ank-maxWidth-760px ank-display-flex ank-flexDirection-column ank-gap-22px ank-textAlign-left",
        "components": [
          "miCuentaHeader",
          "miCuentaMfaSuccess",
          "miCuentaMfaDisabledSuccess",
          "miCuentaLoading",
          "miCuentaError",
          "miCuentaPanel",
          "miCuentaActions"
        ]
      }
    },
    {
      "id": "miCuentaHeader",
      "type": "container",
      "config": {
        "tag": "header",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-10px",
        "components": [
          "miCuentaEyebrow",
          "miCuentaTitle",
          "miCuentaBody"
        ]
      }
    },
    {
      "id": "miCuentaEyebrow",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Área privada",
        "classes": "ank-m-0 ank-fontSize-13px ank-fontWeight-700 ank-letterSpacing-0 ank-textTransform-uppercase ank-color-accentColor"
      }
    },
    {
      "id": "miCuentaTitle",
      "type": "text",
      "config": {
        "tag": "h1",
        "text": "Mi cuenta",
        "classes": "ank-m-0 ank-fontSize-32px ank-lineHeight-1_1 ank-fontWeight-800 ank-color-titleColor"
      }
    },
    {
      "id": "miCuentaBody",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Consulta el estado de tu cuenta y tus permisos actuales. Las operaciones administrativas viven en un área separada.",
        "classes": "ank-m-0 ank-fontSize-16px ank-lineHeight-1_6 ank-color-secondaryTextColor"
      }
    },
    {
      "id": "miCuentaMfaSuccess",
      "type": "text",
      "condition": "all:queryEq,authStatus,mfa-enabled",
      "config": {
        "tag": "p",
        "text": "La verificación en dos pasos quedó activada para tu cuenta.",
        "classes": "ank-m-0 ank-p-14px ank-borderRadius-8px ank-bg-secondaryBgColor ank-border-1px__solid__accentColor ank-color-titleColor ank-fontSize-14px ank-lineHeight-1_5 ank-fontWeight-700"
      }
    },
    {
      "id": "miCuentaMfaDisabledSuccess",
      "type": "text",
      "condition": "all:queryEq,authStatus,mfa-disabled",
      "config": {
        "tag": "p",
        "text": "La verificación en dos pasos quedó desactivada para tu cuenta.",
        "classes": "ank-m-0 ank-p-14px ank-borderRadius-8px ank-bg-secondaryBgColor ank-border-1px__solid__accentColor ank-color-titleColor ank-fontSize-14px ank-lineHeight-1_5 ank-fontWeight-700"
      }
    },
    {
      "id": "miCuentaLoading",
      "type": "container",
      "condition": "all:varEq,remoteStatus.authAccount.state,loading",
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-alignItems-start ank-gap-14px ank-p-20px ank-borderRadius-8px ank-bg-secondaryBgColor ank-border-1px__solid__accentColor ank-boxShadow-0__12px__40px__rgbaSD0COM0COM0COM0_08ED",
        "components": [
          "miCuentaLoadingSpinner",
          "miCuentaLoadingCopy"
        ]
      }
    },
    {
      "id": "miCuentaLoadingSpinner",
      "type": "loading-spinner",
      "config": {
        "classes": "ank-width-22px ank-height-22px ank-border-3px__solid__textColorOPA__0_18 ank-borderTopColor-accentColor ank-borderRadius-50per"
      }
    },
    {
      "id": "miCuentaLoadingCopy",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-4px",
        "components": [
          "miCuentaLoadingTitle",
          "miCuentaLoadingText"
        ]
      }
    },
    {
      "id": "miCuentaLoadingTitle",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Verificando tu sesión...",
        "classes": "ank-m-0 ank-fontSize-15px ank-fontWeight-900 ank-color-titleColor"
      }
    },
    {
      "id": "miCuentaLoadingText",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Después cargaremos los datos de tu cuenta y el estado de seguridad.",
        "classes": "ank-m-0 ank-fontSize-13px ank-lineHeight-1_5 ank-color-secondaryTextColor"
      }
    },
    {
      "id": "miCuentaError",
      "type": "text",
      "condition": "all:varEq,remoteStatus.authAccount.state,error",
      "config": {
        "tag": "p",
        "text": "No pudimos cargar los datos de tu cuenta. Cierra sesión e intenta entrar de nuevo.",
        "classes": "ank-m-0 ank-p-14px ank-borderRadius-8px ank-bg-secondaryBgColor ank-border-1px__solid__errorColor ank-color-errorColor ank-fontSize-14px ank-lineHeight-1_5 ank-fontWeight-700"
      }
    },
    {
      "id": "miCuentaPanel",
      "type": "container",
      "condition": "all:varEq,remoteStatus.authAccount.state,success",
      "config": {
        "tag": "section",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-18px ank-p-24px ank-borderRadius-8px ank-bg-secondaryBgColor ank-border-1px__solid__textColorOPA__0_08 ank-boxShadow-0__12px__40px__rgbaSD0COM0COM0COM0_10ED",
        "components": [
          "miCuentaEmailLabel",
          "miCuentaEmail",
          "miCuentaGrid",
          "miCuentaAdminLink",
          "miCuentaSecuritySection"
        ]
      }
    },
    {
      "id": "miCuentaEmailLabel",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Correo",
        "classes": "ank-m-0 ank-fontSize-13px ank-fontWeight-800 ank-color-secondaryTextColor ank-textTransform-uppercase"
      }
    },
    {
      "id": "miCuentaEmail",
      "type": "text",
      "valueInstructions": "set:config.text,var,remote.auth.account.items.0.email",
      "config": {
        "tag": "p",
        "text": "Correo no disponible",
        "classes": "ank-m-0 ank-fontSize-22px ank-lineHeight-1_25 ank-fontWeight-800 ank-color-titleColor ank-wordBreak-break-word"
      }
    },
    {
      "id": "miCuentaGrid",
      "type": "container",
      "config": {
        "tag": "div",
        "classes": "ank-display-grid ank-gap-12px",
        "styles": {
          "gridTemplateColumns": "repeat(auto-fit, minmax(min(100%, 210px), 1fr))"
        },
        "components": [
          "miCuentaEstado",
          "miCuentaRol",
          "miCuentaAmbiente"
        ]
      }
    },
    {
      "id": "miCuentaEstado",
      "type": "generic-card",
      "valueInstructions": "set:config.description,var,remote.auth.account.items.0.approvalStatus",
      "config": {
        "variant": "feature",
        "title": "Estado de cuenta",
        "description": "Pendiente de aprobación",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-6px ank-p-16px ank-borderRadius-8px ank-bg-bgColor ank-border-1px__solid__textColorOPA__0_08",
        "featureTitleClasses": "ank-m-0 ank-fontSize-14px ank-fontWeight-800 ank-color-secondaryTextColor",
        "featureDescriptionClasses": "ank-m-0 ank-fontSize-16px ank-fontWeight-900 ank-color-titleColor"
      }
    },
    {
      "id": "miCuentaRol",
      "type": "text",
      "valueInstructions": "set:config.text,var,remote.auth.account.items.0.isAdminText",
      "config": {
        "tag": "p",
        "text": "Cliente",
        "classes": "ank-m-0 ank-p-16px ank-borderRadius-8px ank-bg-bgColor ank-border-1px__solid__textColorOPA__0_08 ank-fontSize-16px ank-fontWeight-900 ank-color-titleColor"
      }
    },
    {
      "id": "miCuentaAmbiente",
      "type": "text",
      "valueInstructions": "set:config.text,var,remote.auth.account.items.0.environment",
      "config": {
        "tag": "p",
        "text": "prod",
        "classes": "ank-m-0 ank-p-16px ank-borderRadius-8px ank-bg-bgColor ank-border-1px__solid__textColorOPA__0_08 ank-fontSize-16px ank-fontWeight-900 ank-color-titleColor"
      }
    },
    {
      "id": "miCuentaAdminLink",
      "type": "link",
      "condition": "all:varEq,remote.auth.account.items.0.isAdminText,Administrador",
      "eventInstructions": "trackEvent:auth_admin_link_click,auth,zoosite-admin-users,location,account_page",
      "config": {
        "href": "/admin/usuarios",
        "text": "Administrar usuarios",
        "ariaLabel": "Administrar usuarios de zoositioweb",
        "classes": "ank-width-100per ank-display-flex ank-alignItems-center ank-justifyContent-center ank-minHeight-48px ank-paddingInline-16px ank-paddingBlock-12px ank-borderRadius-8px ank-bg-accentColor ank-color-onSuccessColor ank-fontSize-15px ank-fontWeight-900 ank-textDecoration-none ank-textAlign-center",
        "scrollRestoration": {
          "mode": "top"
        }
      }
    },
    {
      "id": "miCuentaSecuritySection",
      "type": "container",
      "config": {
        "tag": "section",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-14px ank-p-18px ank-borderRadius-8px ank-bg-bgColor ank-border-1px__solid__textColorOPA__0_08",
        "components": [
          "miCuentaSecurityTitle",
          "miCuentaSecurityBody",
          "miCuentaSecurityBodyEnabled",
          "miCuentaSecurityBodyUnknown",
          "miCuentaMfaStartForm",
          "miCuentaMfaSetupPanel",
          "miCuentaMfaVerifyForm",
          "miCuentaMfaDisableSection"
        ]
      }
    },
    {
      "id": "miCuentaSecurityTitle",
      "type": "text",
      "config": {
        "tag": "h2",
        "text": "Seguridad de la cuenta",
        "classes": "ank-m-0 ank-fontSize-22px ank-lineHeight-1_2 ank-fontWeight-800 ank-color-titleColor"
      }
    },
    {
      "id": "miCuentaSecurityBody",
      "type": "text",
      "condition": "all:varEq,remote.auth.account.items.0.mfaSoftwareTokenEnabled,false",
      "config": {
        "tag": "p",
        "text": "Puedes activar verificación en dos pasos desde tu cuenta. Necesitamos tu contraseña actual para preparar una clave segura.",
        "classes": "ank-m-0 ank-fontSize-14px ank-lineHeight-1_6 ank-color-secondaryTextColor"
      }
    },
    {
      "id": "miCuentaSecurityBodyEnabled",
      "type": "text",
      "condition": "all:varEq,remote.auth.account.items.0.mfaSoftwareTokenEnabled,true",
      "config": {
        "tag": "p",
        "text": "Tu cuenta ya tiene verificación en dos pasos. Si necesitas quitarla, confirma tu contraseña actual y el código vigente de la app.",
        "classes": "ank-m-0 ank-fontSize-14px ank-lineHeight-1_6 ank-color-secondaryTextColor"
      }
    },
    {
      "id": "miCuentaSecurityBodyUnknown",
      "type": "text",
      "condition": "all:varEq,remote.auth.account.items.0.mfaStatus,unknown",
      "config": {
        "tag": "p",
        "text": "No pudimos confirmar el estado de tu verificación en dos pasos. Actualiza la página o vuelve a iniciar sesión antes de cambiar esta configuración.",
        "classes": "ank-m-0 ank-fontSize-14px ank-lineHeight-1_6 ank-color-errorColor ank-fontWeight-700"
      }
    },
    {
      "id": "miCuentaMfaStartForm",
      "type": "interaction-scope",
      "condition": "all:varEq,remote.auth.account.items.0.mfaSoftwareTokenEnabled,false;all:varNeq,authForm.startMfaEnrollment.state,success",
      "config": {
        "scopeId": "zoositeMfaEnrollmentStart",
        "tag": "form",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-12px",
        "components": [
          "miCuentaMfaPassword",
          "miCuentaMfaStartError",
          "miCuentaMfaStartButton"
        ]
      }
    },
    {
      "id": "miCuentaMfaPassword",
      "type": "input",
      "config": {
        "fieldId": "password",
        "controlType": "text",
        "inputType": "password",
        "label": "Contraseña actual",
        "showPasswordToggle": true,
        "showPasswordLabel": "Mostrar contraseña",
        "hidePasswordLabel": "Ocultar contraseña",
        "passwordToggleShowIcon": "preview",
        "passwordToggleHideIcon": "visibility_off",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-700 ank-color-titleColor",
        "fieldClasses": "ank-display-flex ank-alignItems-center ank-gap-8px",
        "inputClasses": "ank-width-100per ank-minHeight-46px ank-paddingInline-12px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-secondaryBgColor ank-color-textColor",
        "passwordToggleClasses": "ank-flexShrink-0 ank-width-44px ank-height-44px ank-display-flex ank-alignItems-center ank-justifyContent-center ank-border-1px__solid__secondaryAccentColor ank-borderRadius-8px ank-bg-secondaryBgColor ank-color-titleColor ank-cursor-pointer",
        "passwordToggleIconClasses": "ank-display-block ank-width-24px ank-height-24px ank-fontSize-1_2rem ank-color-titleColor",
        "errorClasses": "ank-color-errorColor ank-fontSize-13px ank-display-flex ank-flexDirection-column ank-gap-4px",
        "validation": [
          {
            "type": "required",
            "message": "Escribe tu contraseña actual."
          }
        ]
      }
    },
    {
      "id": "miCuentaMfaStartError",
      "type": "text",
      "condition": "all:varEq,authForm.startMfaEnrollment.state,error",
      "config": {
        "tag": "p",
        "text": "No pudimos preparar la verificación en dos pasos. Revisa tu contraseña e intenta de nuevo.",
        "classes": "ank-m-0 ank-fontSize-13px ank-lineHeight-1_5 ank-color-errorColor ank-fontWeight-700"
      }
    },
    {
      "id": "miCuentaMfaStartButton",
      "type": "button",
      "valueInstructions": "set:config.loading,when,\"all:varEq,authForm.startMfaEnrollment.state,loading\",true,false",
      "eventInstructions": "authFormAction:startMfaEnrollment,authForm.startMfaEnrollment;trackEvent:auth_mfa_enrollment_start,auth,zoosite-mfa-enroll,location,account_page",
      "config": {
        "type": "button",
        "label": "Activar verificación en dos pasos",
        "loadingLabel": "Preparando...",
        "ariaLabel": "Activar verificación en dos pasos",
        "disabledWhenInvalidScope": true,
        "classes": "ank-width-100per ank-minHeight-48px ank-display-flex ank-alignItems-center ank-justifyContent-center ank-gap-8px ank-paddingInline-16px ank-paddingBlock-12px ank-border-0 ank-borderRadius-8px ank-bg-accentColor ank-color-onSuccessColor ank-fontSize-15px ank-fontWeight-900 ank-cursor-pointer",
        "loadingClasses": "zlp-cursor-wait ank-opacity-0_85",
        "spinnerClasses": "zlp-button-spinner",
        "disabledClasses": "zlp-cursor-not-allowed ank-opacity-0_45 ank-bg-secondaryTextColor ank-color-bgColor"
      }
    },
    {
      "id": "miCuentaMfaSetupPanel",
      "type": "container",
      "condition": "all:varEq,authForm.startMfaEnrollment.state,success",
      "config": {
        "tag": "section",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-12px ank-p-16px ank-borderRadius-8px ank-bg-secondaryBgColor ank-border-1px__solid__textColorOPA__0_08",
        "components": [
          "miCuentaMfaSetupTitle",
          "miCuentaMfaSetupInstructions",
          "miCuentaMfaQrIntro",
          "miCuentaMfaQrCode",
          "miCuentaMfaManualFallbackText",
          "miCuentaMfaSecretLabel",
          "miCuentaMfaSecret"
        ]
      }
    },
    {
      "id": "miCuentaMfaSetupTitle",
      "type": "text",
      "config": {
        "tag": "h3",
        "text": "Agrega esta cuenta a tu app",
        "classes": "ank-m-0 ank-fontSize-18px ank-lineHeight-1_25 ank-fontWeight-800 ank-color-titleColor"
      }
    },
    {
      "id": "miCuentaMfaSetupInstructions",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Abre tu app de autenticación, escanea el QR y después captura el código de 6 números que genere.",
        "classes": "ank-m-0 ank-fontSize-14px ank-lineHeight-1_6 ank-color-secondaryTextColor"
      }
    },
    {
      "id": "miCuentaMfaQrIntro",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Escanea este código desde Google Authenticator, Microsoft Authenticator, 1Password u otra app compatible.",
        "classes": "ank-m-0 ank-fontSize-13px ank-lineHeight-1_55 ank-color-secondaryTextColor"
      }
    },
    {
      "id": "miCuentaMfaQrCode",
      "type": "qr-code",
      "valueInstructions": "set:config.value,var,authForm.startMfaEnrollment.data.setup.otpauthUri",
      "config": {
        "id": "miCuentaMfaQrCode",
        "value": "",
        "ariaLabel": "Código QR para configurar verificación en dos pasos",
        "classes": "ank-alignSelf-center ank-display-flex ank-alignItems-center ank-justifyContent-center ank-p-12px ank-borderRadius-8px ank-bg-bgColor ank-border-1px__solid__textColorOPA__0_18",
        "gridClasses": "ank-borderRadius-4px",
        "moduleClasses": "",
        "emptyClasses": "ank-fontSize-13px ank-color-secondaryTextColor ank-textAlign-center",
        "errorClasses": "ank-fontSize-13px ank-color-errorColor ank-fontWeight-700 ank-textAlign-center",
        "emptyText": "QR no disponible. Usa la clave manual.",
        "errorText": "No pudimos generar el QR. Usa la clave manual.",
        "size": 220,
        "margin": 2,
        "errorCorrectionLevel": "M",
        "darkColor": "#0d141c",
        "lightColor": "#ffffff"
      }
    },
    {
      "id": "miCuentaMfaManualFallbackText",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Si no puedes escanearlo, usa esta clave manual.",
        "classes": "ank-m-0 ank-fontSize-13px ank-lineHeight-1_55 ank-color-secondaryTextColor"
      }
    },
    {
      "id": "miCuentaMfaSecretLabel",
      "type": "text",
      "config": {
        "tag": "p",
        "text": "Clave manual",
        "classes": "ank-m-0 ank-fontSize-13px ank-fontWeight-800 ank-color-secondaryTextColor ank-textTransform-uppercase"
      }
    },
    {
      "id": "miCuentaMfaSecret",
      "type": "text",
      "valueInstructions": "set:config.text,var,authForm.startMfaEnrollment.data.setup.sharedSecret",
      "config": {
        "tag": "p",
        "text": "Clave no disponible",
        "classes": "ank-m-0 ank-p-14px ank-borderRadius-8px ank-bg-bgColor ank-border-1px__solid__textColorOPA__0_18 ank-color-titleColor ank-fontSize-16px ank-lineHeight-1_45 ank-fontWeight-900 ank-letterSpacing-0",
        "styles": {
          "overflowWrap": "anywhere",
          "wordBreak": "break-all",
          "whiteSpace": "normal",
          "maxWidth": "100%"
        }
      }
    },
    {
      "id": "miCuentaMfaVerifyForm",
      "type": "interaction-scope",
      "condition": "all:varEq,authForm.startMfaEnrollment.state,success",
      "config": {
        "scopeId": "zoositeMfaEnrollmentVerify",
        "tag": "form",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-12px",
        "components": [
          "miCuentaMfaVerifyTitle",
          "miCuentaMfaCode",
          "miCuentaMfaVerifyError",
          "miCuentaMfaVerifyButton"
        ]
      }
    },
    {
      "id": "miCuentaMfaVerifyTitle",
      "type": "text",
      "config": {
        "tag": "h3",
        "text": "Confirma el código",
        "classes": "ank-m-0 ank-fontSize-18px ank-lineHeight-1_25 ank-fontWeight-800 ank-color-titleColor"
      }
    },
    {
      "id": "miCuentaMfaCode",
      "type": "input",
      "config": {
        "fieldId": "code",
        "controlType": "text",
        "inputType": "tel",
        "label": "Código de la app",
        "placeholder": "000000",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-6px",
        "labelClasses": "ank-fontSize-14px ank-fontWeight-700 ank-color-titleColor",
        "inputClasses": "ank-width-100per ank-minHeight-46px ank-paddingInline-12px ank-borderRadius-8px ank-border-1px__solid__textColorOPA__0_18 ank-bg-secondaryBgColor ank-color-textColor ank-letterSpacing-0",
        "errorClasses": "ank-color-errorColor ank-fontSize-13px ank-display-flex ank-flexDirection-column ank-gap-4px",
        "validation": [
          {
            "type": "required",
            "message": "Escribe el código."
          },
          {
            "type": "pattern",
            "value": "^\\d{6}$",
            "message": "El código debe tener 6 números."
          }
        ]
      }
    },
    {
      "id": "miCuentaMfaVerifyError",
      "type": "text",
      "condition": "all:varEq,authForm.verifyMfaEnrollment.state,error",
      "config": {
        "tag": "p",
        "text": "No pudimos activar la verificación. Revisa el código actual de la app e intenta de nuevo.",
        "classes": "ank-m-0 ank-fontSize-13px ank-lineHeight-1_5 ank-color-errorColor ank-fontWeight-700"
      }
    },
    {
      "id": "miCuentaMfaVerifyButton",
      "type": "button",
      "valueInstructions": "set:config.loading,when,\"all:varEq,authForm.verifyMfaEnrollment.state,loading\",true,false",
      "eventInstructions": "authFormAction:verifyMfaEnrollment,authForm.verifyMfaEnrollment;trackEvent:auth_mfa_enrollment_verify,auth,zoosite-mfa-enroll,location,account_page",
      "config": {
        "type": "button",
        "label": "Confirmar verificación",
        "loadingLabel": "Verificando...",
        "ariaLabel": "Confirmar verificación en dos pasos",
        "disabledWhenInvalidScope": true,
        "classes": "ank-width-100per ank-minHeight-48px ank-display-flex ank-alignItems-center ank-justifyContent-center ank-gap-8px ank-paddingInline-16px ank-paddingBlock-12px ank-border-0 ank-borderRadius-8px ank-bg-accentColor ank-color-onSuccessColor ank-fontSize-15px ank-fontWeight-900 ank-cursor-pointer",
        "loadingClasses": "zlp-cursor-wait ank-opacity-0_85",
        "spinnerClasses": "zlp-button-spinner",
        "disabledClasses": "zlp-cursor-not-allowed ank-opacity-0_45 ank-bg-secondaryTextColor ank-color-bgColor"
      }
    },
    {
      "id": "miCuentaMfaDisableSection",
      "type": "container",
      "condition": "all:varEq,remote.auth.account.items.0.mfaSoftwareTokenEnabled,true;all:varNeq,authForm.startMfaEnrollment.state,success",
      "config": {
        "tag": "section",
        "classes": "ank-display-flex ank-flexDirection-column ank-gap-12px ank-p-16px ank-borderRadius-8px ank-bg-secondaryBgColor ank-border-1px__solid__textColorOPA__0_08",
        "components": [
          "miCuentaMfaDisableTitle",
          "miCuentaMfaDisableBody",
          "miCuentaMfaDisableForm"
