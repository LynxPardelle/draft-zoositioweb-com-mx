      "config": {
        "type": "button",
        "label": "Desactivar verificación",
        "loadingLabel": "Desactivando...",
        "ariaLabel": "Desactivar verificación en dos pasos",
        "disabledWhenInvalidScope": true,
        "classes": "ank-width-100per ank-minHeight-48px ank-display-flex ank-alignItems-center ank-justifyContent-center ank-gap-8px ank-paddingInline-16px ank-paddingBlock-12px ank-border-1px__solid__errorColor ank-borderRadius-8px ank-bg-transparent ank-color-errorColor ank-fontSize-15px ank-fontWeight-900 ank-cursor-pointer",
        "loadingClasses": "zlp-cursor-wait ank-opacity-0_85",
        "spinnerClasses": "zlp-button-spinner",
        "disabledClasses": "zlp-cursor-not-allowed ank-opacity-0_45 ank-bg-secondaryTextColor ank-color-bgColor"
      }
    },
